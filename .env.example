# Admin sign-in. Change this before sharing the site.
ADMIN_PASSWORD=lotus-admin

# Used to sign the admin cookie. Use a long random string in production.
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret

# Supabase catalog + image storage (required for admin uploads / production).
# 1) Create a project at https://supabase.com
# 2) Run supabase/schema.sql in the SQL editor
# 3) Project Settings → API Keys → Legacy → service_role (or Secret key)
# 4) npm run sync:supabase
# 5) Restart npm run dev
#
# Use the project URL only (no /rest/v1 suffix).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional escape hatch for offline JSON file CMS. Leave unset for Supabase.
# CMS_STORAGE=file

# Optional: 21st.dev API key for `npx shadcn@latest add "https://21st.dev/r/..."` in admin UI work.
# API_KEY_21ST=
